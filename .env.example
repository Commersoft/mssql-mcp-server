MSSQL_SERVER=uran
MSSQL_DATABASE=cs
MSSQL_USER=<login>
MSSQL_PASSWORD=<password>
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=yes
RAG_WORKSPACE_ROOT=<ścieżka do katalogu głównego repo>

# --- profile execute_sql(server=...) — creds per środowisko (opcjonalne) ---
# UWAGA: parser bierze CAŁĄ resztę linii po "=" jako wartość — nie dopisuj komentarza za hasłem.
# PROD  cs-sql03/cs04 (user adminjmk)
# CSPROD_PWD=<password>
# CSSQL01  cs-sql01\cs (user adminjmk)
# CSSQL01_PWD=<password>
# SAVPOL  CS-SQL02\SAVPOL/cs06 (user adminjmk)
# CSSAVPOL_PWD=<password>
# TESTGRODNO  CS-BCKP01\GRODNO/test04
# CSTESTGRODNO_USER=<login>
# CSTESTGRODNO_PWD=<password>
# SLGRODNO  CS-BCKP01\GRODNO/sl_grodno — puste = fallback na CSTESTGRODNO_* (ten sam serwer)
# CSSLGRODNO_USER=<login>
# CSSLGRODNO_PWD=<password>

# PBS  CS-SQL03\PBS/csPBS — PRODUKCJA instalacji PBS (osobna instancja)
# CSPBS_USER=<login>
# CSPBS_PWD=***

# --- send_email (opcjonalne) ---
# Gmail/Workspace: wymaga 2FA + App Password (https://myaccount.google.com/apppasswords)
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_USER=<imie.nazwisko@certusoft.pl>
MAIL_APP_PASSWORD=<app-password>
MAIL_FROM_NAME=<Imię Nazwisko>
MAIL_ALLOWED_RECIPIENT_DOMAINS=certusoft.pl